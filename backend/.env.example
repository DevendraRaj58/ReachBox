NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-another-long-random-secret

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# JSON array of Ethereal SMTP sender accounts.
ETHEREAL_SENDERS_JSON=[{"name":"Sender One","address":"sender1@example.test","user":"","pass":""},{"name":"Sender Two","address":"sender2@example.test","user":"","pass":""}]

WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_RETRIES=2

BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change-me

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
